# /etc/easy-fleet/easy-fleet.env   (mode 0640, owner root:easyfleet) — NON-SECRET settings only.
# Nothing in this file is a password or key. Secrets live in AWS Secrets Manager and reach the app as files
# (see the *_FILE lines below). Never commit the real file.

NODE_ENV=production
PORT=4000
# Listen on the loopback only is enforced by the security group + Caddy; the app binds all interfaces on PORT,
# so keep port 4000 closed in the EC2 security group.

# ---- Production data safety: the demo seed refuses to run here (it also refuses on any database named
# easyfleet_production). Never enable the demo seed on this host.
EF_FORBID_DEMO_SEED=true

# ---- Public address (HTTPS is mandatory: cookies are __Host-/Secure, camera/GPS/PWA need a secure context)
APP_ORIGINS=https://fleet.example.com
APP_URL=https://fleet.example.com
PUBLIC_APP_URL=https://fleet.example.com
COOKIE_SECURE=true
# Accident case workflow API (/api/accident-cases): keep false until the accident roles/permissions are in the database.
ACCIDENT_WORKFLOW_ENABLED=false
# Sensitive-document rule for LEGACY accidents (police/insurance files). Independent of the switch above; changes who sees existing files, so enable it on its own.
ACCIDENT_LEGACY_SENSITIVE_ENFORCEMENT=false
# Proxies in front of Node: Caddy only = 1, ALB + Caddy = 2, CloudFront + ALB + Caddy = 3.
TRUST_PROXY=1

# ---- Static files of the built web app
WEB_DIST_DIR=/opt/easy-fleet/current/web/dist

# ---- Database: RDS PostgreSQL 16. The connection string itself is a secret (DATABASE_URL_FILE below).
DB_SSL=verify-full
DB_SSL_CA_FILE=/opt/easy-fleet/rds-global-bundle.pem
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# ---- Files: private S3 bucket, credentials from the EC2 instance role (no keys here)
STORAGE_PROVIDER=s3
# The disk that holds logs and temporary files must not fill up either: /api/readyz fails below this (MB).
DISK_MIN_FREE_MB=256
S3_BUCKET=easy-fleet-prod-files
S3_REGION=eu-central-1
S3_PREFIX=files/
S3_SSE=aws:kms
# S3_KMS_KEY_ID=arn:aws:kms:…            # omit to use the AWS-managed key for S3 (S3_SSE=AES256 is also fine)
MAX_UPLOAD_MB=10
# Opt-in: delete uploads that no record references for 7+ days (turn on after the first smoke test).
ORPHAN_FILE_CLEANUP=false
ORPHAN_FILE_DAYS=7

# ---- Time and sessions
APP_TIMEZONE=Asia/Riyadh
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# ---- Logging (journald collects stdout/stderr)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUESTS=true
SHUTDOWN_TIMEOUT_SECONDS=15

# ---- Email (SMTP; Amazon SES SMTP works: host email-smtp.<region>.amazonaws.com, port 587, STARTTLS)
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=STARTTLS
EMAIL_FROM=no-reply@fleet.example.com
EMAIL_FROM_NAME="Easy Fleet"
SUPPORT_EMAIL=support@example.com
EMAIL_QUEUE_INTERVAL_SECONDS=15
PASSWORD_RESET_TTL_MINUTES=30

# ---- Bright Washing (server-side only; id and secret come from Secrets Manager)
BRIGHT_WASHING_BASE_URL=

# ---- First administrator (used once by `npm run db:setup`; delete these lines afterwards)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME="System Administrator"
# the password is a secret: BOOTSTRAP_ADMIN_PASSWORD_FILE below, removed after the first start

# ======================= SECRETS (files written by fetch-secrets.sh; names from the secret's JSON keys) ============
DATABASE_URL_FILE=/run/easy-fleet/secrets/DATABASE_URL
EMAIL_SETTINGS_KEY_FILE=/run/easy-fleet/secrets/EMAIL_SETTINGS_KEY
SMTP_USER_FILE=/run/easy-fleet/secrets/SMTP_USER
SMTP_PASSWORD_FILE=/run/easy-fleet/secrets/SMTP_PASSWORD
BRIGHT_WASHING_INTEGRATION_ID_FILE=/run/easy-fleet/secrets/BRIGHT_WASHING_INTEGRATION_ID
BRIGHT_WASHING_API_SECRET_FILE=/run/easy-fleet/secrets/BRIGHT_WASHING_API_SECRET
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/easy-fleet/secrets/BOOTSTRAP_ADMIN_PASSWORD
