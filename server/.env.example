# Copy to .env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://easy_fleet:CHANGE_ME@localhost:5432/easy_fleet

# Comma-separated list of browser origins allowed to call the API (CSRF/origin check).
# Production requires https origins. On Render it defaults to RENDER_EXTERNAL_URL when unset.
APP_ORIGINS=http://localhost:5173

# Session lifetime
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Set to "true" when served behind HTTPS (required in production).
COOKIE_SECURE=false

# Set to the number of trusted reverse proxies in front of the app (0 when none).
TRUST_PROXY=0

# Business time zone used to decide "today" for expiry rules (registrations, insurance, licenses).
APP_TIMEZONE=Asia/Riyadh

# Private directory for uploaded documents (NOT inside any served folder). Max upload size in MB.
STORAGE_DIR=./storage
# STORAGE_ROOT overrides STORAGE_DIR (e.g. a mounted disk on Render: /var/data/storage)
# STORAGE_ROOT=
MAX_UPLOAD_MB=10

# Optional: path to the built frontend (web/dist) to serve from the same origin.
# WEB_DIST_DIR=../web/dist

# Used only by `npm run db:bootstrap` to create the first SUPER_ADMIN (then remove it).
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=

# Disposable database used by `npm test` (dropped and rebuilt on every run).
TEST_DATABASE_URL=postgres://easy_fleet:CHANGE_ME@localhost:5432/easy_fleet_test

# --- Full system (all optional) ---
# Public base URL used in handover links and vehicle QR codes (defaults to the first APP_ORIGINS entry)
# PUBLIC_APP_URL=https://fleet.example
# Days a vehicle handover link stays valid
# HANDOVER_LINK_DAYS=14
# Map tiles: leave unset for the CARTO Voyager basemap (no key, OpenStreetMap data).
# A template carrying a key (key=, api_key=, access_token=…) stays server-side (proxied via /api/map/tiles).
# tile.openstreetmap.org is never used (OSM tile usage policy): the default provider is used instead. TILE_URL is accepted as an alias.
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=REPLACE_ME
# MAP_ATTRIBUTION=© <a href="https://www.maptiler.com/copyright/">MapTiler</a> © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# MAP_TILE_SUBDOMAINS=abc
# MAP_TILE_MAX_ZOOM=19
# MAP_TILE_PROXY=auto
# MAP_DEFAULT_CENTER=24.7136,46.6753
# Disable in-process background jobs (expiry reminders, cleanup) — e.g. when running them via cron: npm run jobs:run
# DISABLE_JOBS=false

# ---- Email (server-side only; the browser never talks to the mail provider). See docs/EMAIL.md.
# Public https URL used in password reset links (takes precedence over PUBLIC_APP_URL). Never hardcode the Render URL in code.
# APP_URL=https://fleet.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=REPLACE_ME
# SMTP_PASSWORD=REPLACE_ME
# SMTP_SECURE=STARTTLS          # TLS (port 465) | STARTTLS (587) | NONE (local relay only); default: TLS on 465, else STARTTLS
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Easy Fleet
# SUPPORT_EMAIL=support@example.com
# Optional: allows saving the SMTP password from Settings → Email (stored AES-256-GCM encrypted). 32 bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# EMAIL_SETTINGS_KEY=REPLACE_ME
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_QUEUE_INTERVAL_SECONDS=15
