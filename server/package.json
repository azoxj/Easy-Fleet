{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:render": "node --env-file-if-exists=.env dist/scripts/migrate.js && node --env-file-if-exists=.env dist/scripts/bootstrap.js && npm run start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env src/scripts/bootstrap.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "db:setup": "npm run db:migrate && npm run db:bootstrap",
    "jobs:run": "tsx --env-file-if-exists=.env src/scripts/run-jobs.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
